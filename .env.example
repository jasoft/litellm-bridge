ELEVENLABS_API_KEY=your_key_here
# Set a private master key for the LiteLLM proxy. Clients use this as their bearer token.
LITELLM_MASTER_KEY=REPLACE_WITH_A_RANDOM_SECRET
# Optional: ordered STT keys; overrides ELEVENLABS_API_KEY for transcription.
# ELEVENLABS_API_KEYS=primary_key,backup_key,third_key
ELEVENLABS_API_BASE=https://api.elevenlabs.io
